# Copy this template to a secret file outside Git, set mode 0600, and pass it
# explicitly with: docker compose --env-file /secure/path/production.env ...
# Values below are placeholders, not production credentials.

# Host binding and Docker network ranges. Change subnets if they overlap with
# existing host/VPN networks. APP_EGRESS_GATEWAY is also the exact TRUST_PROXY.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=3100
DATABASE_SUBNET=172.30.10.0/24
DATABASE_GATEWAY=172.30.10.1
APP_EGRESS_SUBNET=172.30.20.0/24
APP_EGRESS_GATEWAY=172.30.20.1

# PostgreSQL. Use the same URL-encoded password in DATABASE_URL.
POSTGRES_DB=mercado
POSTGRES_USER=mercado_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://mercado_app:replace-with-a-strong-database-password@postgres:5432/mercado

# Application runtime. Compose fixes NODE_ENV/PORT and container-only paths,
# but they are documented here so the complete production contract is visible.
NODE_ENV=production
PORT=3000
AUTH0_DOMAIN=tenant.example.auth0.com
AUTH0_AUDIENCE=https://api.example.com
LOG_LEVEL=info
# This remains the public HTTPS frontend origin; Nginx exposes the API domain.
CORS_ORIGIN=https://shop.example.com
TRUST_PROXY=172.30.20.1
S3_PUBLIC_BASE_URL=https://cdn.example.com
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
EMAIL_PROVIDER=console
BACKUP_ARTIFACT_DIR=/var/lib/mercado-artesanal/backups
PG_DUMP_PATH=/usr/lib/postgresql/16/bin/pg_dump
PG_RESTORE_PATH=/usr/lib/postgresql/16/bin/pg_restore
BACKUP_OPERATION_TIMEOUT_MS=300000
BACKUP_DATABASE_HOST_ALLOWLIST=postgres
