NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mercado
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.mercado.example
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
# Public base URL for S3 product image assets (bucket public endpoint or CDN).
# HTTPS is required in production. http:// is accepted for local dev (MinIO / LocalStack).
S3_PUBLIC_BASE_URL=https://cdn.example.com

# Stripe secret key (server-side only, never sent to the browser).
# Used by src/modules/payments/services/stripe.client.ts to create PaymentIntents.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook signing secret (server-side only, never sent to the browser).
# Used by src/modules/payments/services/payments.service.ts to verify the raw
# body signature on POST /pagos/webhook (Stripe CLI: `stripe listen --print-secret`).
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email provider used by src/shared/email/email-provider.ts. "console" (default)
# logs and makes no external call — safe for local/demo use. "ses" sends real
# email via @aws-sdk/client-ses (src/shared/email/ses-email-provider.ts).
EMAIL_PROVIDER=console

# Private backup storage. The server creates the root/subdirectories at startup.
BACKUP_ARTIFACT_DIR=/var/lib/mercado-artesanal/backups
# Install PostgreSQL Client 16 and point to its real, non-symlinked executables.
PG_DUMP_PATH=/usr/lib/postgresql/16/bin/pg_dump
PG_RESTORE_PATH=/usr/lib/postgresql/16/bin/pg_restore
BACKUP_OPERATION_TIMEOUT_MS=300000

# Docker Compose PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=mercado
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
